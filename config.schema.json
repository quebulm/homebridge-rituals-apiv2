{
  "pluginAlias": "Rituals",
  "pluginType": "accessory",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "accessory": {
        "title": "Accessory Type",
        "type": "string",
        "default": "Rituals",
        "readOnly": true
      },
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Genie",
        "required": true
      },
      "account": {
        "title": "E-mail",
        "type": "string",
        "required": true
      },
      "password": {
        "title": "Password",
        "type": "string",
        "format": "password",
        "required": true
      },
      "humidifier": {
        "title": "Show as Humidifier instead of Fan (opt-in, changes the HomeKit service type)",
        "type": "boolean",
        "default": false
      },
      "battery": {
        "title": "Show Battery service (static 100%/charging reading, not a real measurement - untick if your Genie has no battery)",
        "type": "boolean",
        "default": true
      }
    }
  }
}